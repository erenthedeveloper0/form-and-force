evals/results/
ff-audit/
link-audit*.md
release-check*.md
*.log

# Screenshots of third-party websites taken during research. They show
# copyrighted sites, so they stay local and are not redistributed.
research/captures/*/*.jpg
research/captures/*/*.jpeg
research/captures/*/*.png
research/captures/*/*.webp
