secrets.json
secrets.yml
secrets.yaml

# Personal Claude Code settings
.claude/settings.local.json
CLAUDE.local.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

